{
    "name": "mk-j/diseval",
    "description": "PHP extension that disables eval() (PIE / Composer installable)",
    "type": "php-ext",
    "license": "MIT",
    "keywords": ["eval", "security", "php-ext", "pie", "extension"],
    "require": {
        "php": "^8.0"
    },
    "php-ext": {
        "extension-name": "diseval",
        "build-path": "source",
        "support-zts": true,
        "support-nts": true,
        "download-url-method": ["pre-packaged-binary", "composer-default"],
        "os-families-exclude": ["windows"]
    }
}
